#!/bin/sh
# mothership: before removal or upgrade.
# deb: remove | upgrade <new> | deconfigure | failed-upgrade; rpm: 0 = erase, 1 = upgrade.
case "${1:-}" in
  remove|0)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now mothership-fire.service >/dev/null 2>&1 || true
    else
      systemctl disable mothership-fire.service >/dev/null 2>&1 || true
    fi
    ;;
esac
case "${1:-}" in
  1) ;;  # rpm upgrade: the new package has already compiled its files
  *) rm -rf /usr/lib/mothership/python/mothership/__pycache__ ;;
esac
exit 0
