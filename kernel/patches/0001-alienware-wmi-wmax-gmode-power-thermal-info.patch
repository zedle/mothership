+	struct awcc_priv *priv;
+
+	/* Without AWCC support the drvdata is not an awcc_priv */
+	if (!awcc)
+		return 0;
+
+	priv = dev_get_drvdata(kobj_to_dev(kobj));
+
+	if (attr == &dev_attr_gmode.attr)
+		return priv->gmode ? attr->mode : 0;
+	if (attr == &dev_attr_default_profile.attr)
+		return priv->default_profile ? attr->mode : 0;
+	if (attr == &dev_attr_cooling_type.attr)
+		return priv->cooling_type ? attr->mode : 0;
+	if (attr == &dev_attr_touchpad_lighting.attr)
+		return priv->touchpad_lighting ? attr->mode : 0;
+
+	return 0;
+}
