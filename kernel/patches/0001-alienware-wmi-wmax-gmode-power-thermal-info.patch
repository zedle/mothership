 	AWCC_OP_GET_FAN_MAX_RPM			= 0x09,
+	AWCC_OP_GET_DEFAULT_PROFILE		= 0x0A,
 	AWCC_OP_GET_CURRENT_PROFILE		= 0x0B,
 	AWCC_OP_GET_FAN_BOOST			= 0x0C,
 };
@@ -257,6 +263,12 @@ enum AWCC_THERMAL_CONTROL_OPERATIONS {
 	AWCC_OP_SET_FAN_BOOST			= 0x02,
 };
 
+enum AWCC_POWER_INFORMATION_OPERATIONS {
