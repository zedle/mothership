+	AWCC_OP_GET_ADAPTER_STATUS		= 0x04,
+};
+
 enum AWCC_GAME_SHIFT_STATUS_OPERATIONS {
 	AWCC_OP_TOGGLE_GAME_SHIFT		= 0x01,
 	AWCC_OP_GET_GAME_SHIFT_STATUS		= 0x02,
@@ -267,6 +279,17 @@ enum AWCC_THERMAL_TABLES {
 	AWCC_THERMAL_TABLE_USTT			= 0xA,
 };
 
+enum AWCC_COOLING_TYPES {
+	AWCC_COOLING_AIR			= 0x01,
+	AWCC_COOLING_LIQUID			= 0x02,
+};
+
+enum AWCC_ADAPTER_STATUS {
+	AWCC_ADAPTER_STATUS_OK			= 0x01,
+	AWCC_ADAPTER_STATUS_UNDERSIZED		= 0x02,
+	AWCC_ADAPTER_STATUS_UNSUPPORTED		= 0x09,
+};
+
 enum AWCC_TEMP_SENSOR_TYPES {
 	AWCC_TEMP_SENSOR_CPU			= 0x01,
 	AWCC_TEMP_SENSOR_FRONT			= 0x03,
@@ -358,6 +381,19 @@ struct awcc_priv {
 	unsigned long temp_sensors[AWCC_ID_BITMAP_LONGS];
 
 	u32 gpio_count;
+
+	/* G-Mode through GameShiftStatus, tied to the performance profile */
+	bool game_shift;
+
+	/* G-Mode as a thermal profile of its own, through the gmode attribute */
+	bool gmode;
+	bool gmode_restore_valid;
+	u8 gmode_restore;
+	struct mutex gmode_lock;
+
+	bool power_info;
+	bool default_profile;
+	bool cooling_type;
 };
 
 static struct awcc_quirks *awcc;
@@ -700,6 +736,19 @@ static int awcc_game_shift_status(struct wmi_device *wdev, u8 operation,
 	return awcc_wmi_command(wdev, AWCC_METHOD_GAME_SHIFT_STATUS, &args, out);
 }
 
+static int awcc_power_information(struct wmi_device *wdev, u8 operation, u8 arg,
+				  u32 *out)
+{
+	struct wmax_u32_args args = {
+		.operation = operation,
+		.arg1 = arg,
+		.arg2 = 0,
+		.arg3 = 0,
+	};
+
+	return awcc_wmi_command(wdev, AWCC_METHOD_POWER_INFORMATION, &args, out);
+}
+
 /**
  * awcc_op_get_resource_id - Get the resource ID at a given index
  * @wdev: AWCC WMI device
@@ -800,6 +849,20 @@ static int awcc_op_activate_profile(struct wmi_device *wdev, u8 profile)
 	return awcc_wmi_command(wdev, AWCC_METHOD_THERMAL_CONTROL, &args, &out);
 }
 
+/*
+ * Thermal profile IDs are listed last at offset
+ *	fan_count + temp_count + unknown_count
+ */
+static u8 awcc_profile_id_offset(const struct awcc_priv *priv)
+{
+	u8 offset = 0;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(priv->res_count) - 1; i++)
+		offset += priv->res_count[i];
+
+	return offset;
+}
+
 static int awcc_op_set_fan_boost(struct wmi_device *wdev, u8 fan_id, u8 boost)
 {
 	struct wmax_u32_args args = {
@@ -1267,10 +1330,10 @@ static int awcc_platform_profile_set(struct device *dev,
 				     enum platform_profile_option profile)
 {
 	struct awcc_priv *priv = dev_get_drvdata(dev);
+	int ret;
 
-	if (awcc->gmode) {
+	if (priv->game_shift) {
 		u32 gmode_status;
-		int ret;
 
 		ret = awcc_game_shift_status(priv->wdev,
 					     AWCC_OP_GET_GAME_SHIFT_STATUS,
@@ -1290,22 +1353,25 @@ static int awcc_platform_profile_set(struct device *dev,
 		}
 	}
 
-	return awcc_op_activate_profile(priv->wdev, priv->supported_profiles[profile]);
+	ret = awcc_op_activate_profile(priv->wdev, priv->supported_profiles[profile]);
+	if (ret)
+		return ret;
+
+	/* A new profile replaces G-Mode */
+	if (priv->gmode)
+		sysfs_notify(&priv->wdev->dev.kobj, NULL, "gmode");
+
+	return 0;
 }
 
 static int awcc_platform_profile_probe(void *drvdata, unsigned long *choices)
 {
 	enum platform_profile_option profile;
 	struct awcc_priv *priv = drvdata;
-	u8 id, offset = 0;
+	u8 id, offset;
 	int ret;
 
-	/*
-	 * Thermal profile IDs are listed last at offset
-	 *	fan_count + temp_count + unknown_count
-	 */
-	for (unsigned int i = 0; i < ARRAY_SIZE(priv->res_count) - 1; i++)
-		offset += priv->res_count[i];
+	offset = awcc_profile_id_offset(priv);
 
 	for (unsigned int i = 0; i < priv->profile_count; i++) {
 		ret = awcc_op_get_resource_id(priv->wdev, i + offset, &id);
@@ -1338,7 +1404,7 @@ static int awcc_platform_profile_probe(void *drvdata, unsigned long *choices)
 	if (bitmap_empty(choices, PLATFORM_PROFILE_LAST))
 		return -ENODEV;
 
-	if (awcc->gmode) {
+	if (priv->game_shift) {
 		priv->supported_profiles[PLATFORM_PROFILE_PERFORMANCE] =
 			AWCC_PROFILE_SPECIAL_GMODE;
 
@@ -1370,6 +1436,366 @@ static int awcc_platform_profile_init(struct wmi_device *wdev)
 	return PTR_ERR_OR_ZERO(priv->ppdev);
 }
 
+/*
+ * G-Mode
+ *  - On models that list the G-Mode thermal profile (0xAB) but have no
+ *    GameShiftStatus method, G-Mode is activated like any other thermal
+ *    profile. It is exposed as a switch of its own, so "performance" keeps
+ *    its regular profile and the previous profile can be restored.
+ */
+static int awcc_gmode_listed(struct awcc_priv *priv, bool *listed)
+{
+	u8 id, offset;
+	int ret;
+
+	offset = awcc_profile_id_offset(priv);
+	*listed = false;
+
+	for (unsigned int i = 0; i < priv->profile_count; i++) {
+		ret = awcc_op_get_resource_id(priv->wdev, i + offset, &id);
+		if (ret == -EBADRQC)
+			break;
+		if (ret)
+			return ret;
+
+		if (id == AWCC_PROFILE_SPECIAL_GMODE) {
+			*listed = true;
+			break;
+		}
+	}
+
+	return 0;
+}
+
+static void awcc_game_shift_init(struct awcc_priv *priv)
+{
+	u32 status;
+	int ret;
+
+	if (!awcc->gmode)
+		return;
+
+	/*
+	 * Some BIOSes that support G-Mode lack the GameShiftStatus method.
+	 * Calling it before every profile change would then make every
+	 * change fail.
+	 */
+	ret = awcc_game_shift_status(priv->wdev, AWCC_OP_GET_GAME_SHIFT_STATUS,
+				     &status);
+	if (ret) {
+		dev_warn(&priv->wdev->dev,
+			 "GameShiftStatus is not supported (%d), G-Mode will not be tied to the performance profile\n",
+			 ret);
+		return;
+	}
+
+	priv->game_shift = true;
+}
+
+static ssize_t gmode_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 profile;
+	int ret;
+
+	ret = awcc_op_get_current_profile(priv->wdev, &profile);
+	if (ret)
+		return ret;
+
+	profile = FIELD_GET(AWCC_RESOURCE_ID_MASK, profile);
+
+	return sysfs_emit(buf, "%d\n", profile == AWCC_PROFILE_SPECIAL_GMODE);
+}
+
+static ssize_t gmode_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 current_profile, default_profile;
+	bool enable;
+	u8 target;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	scoped_guard(mutex, &priv->gmode_lock) {
+		ret = awcc_op_get_current_profile(priv->wdev, &current_profile);
+		if (ret)
+			return ret;
+
+		current_profile = FIELD_GET(AWCC_RESOURCE_ID_MASK, current_profile);
+
+		if (enable == (current_profile == AWCC_PROFILE_SPECIAL_GMODE))
+			return count;
+
+		if (enable) {
+			target = AWCC_PROFILE_SPECIAL_GMODE;
+		} else if (priv->gmode_restore_valid) {
+			target = priv->gmode_restore;
+		} else {
+			ret = awcc_thermal_information(priv->wdev,
+						       AWCC_OP_GET_DEFAULT_PROFILE,
+						       0, &default_profile);
+			if (ret)
+				return ret;
+
+			target = FIELD_GET(AWCC_RESOURCE_ID_MASK, default_profile);
+			if (target == AWCC_PROFILE_SPECIAL_GMODE)
+				return -EIO;
+		}
+
+		ret = awcc_op_activate_profile(priv->wdev, target);
+		if (ret)
+			return ret;
+
+		priv->gmode_restore = current_profile;
+		priv->gmode_restore_valid = enable;
+	}
+
+	if (priv->ppdev)
+		platform_profile_notify(priv->ppdev);
+
+	sysfs_notify(&dev->kobj, NULL, "gmode");
+
+	return count;
+}
+
+static DEVICE_ATTR(gmode, 0664, gmode_show, gmode_store);
+
+/*
+ * Thermal information
+ */
+static const char * const awcc_pprof_names[] = {
+	[PLATFORM_PROFILE_LOW_POWER] = "low-power",
+	[PLATFORM_PROFILE_COOL] = "cool",
+	[PLATFORM_PROFILE_QUIET] = "quiet",
+	[PLATFORM_PROFILE_BALANCED] = "balanced",
+	[PLATFORM_PROFILE_BALANCED_PERFORMANCE] = "balanced-performance",
+	[PLATFORM_PROFILE_PERFORMANCE] = "performance",
+	[PLATFORM_PROFILE_MAX_POWER] = "max-power",
+	[PLATFORM_PROFILE_CUSTOM] = "custom",
+};
+static_assert(ARRAY_SIZE(awcc_pprof_names) == PLATFORM_PROFILE_LAST);
+
+static ssize_t default_profile_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	enum platform_profile_option pprof;
+	u32 profile;
+	int ret;
+
+	ret = awcc_thermal_information(priv->wdev, AWCC_OP_GET_DEFAULT_PROFILE,
+				       0, &profile);
+	if (ret)
+		return ret;
+
+	if (awcc_profile_to_pprof(profile, &pprof))
+		return sysfs_emit(buf, "0x%02x\n", profile);
+
+	return sysfs_emit(buf, "%s\n", awcc_pprof_names[pprof]);
+}
+
+static DEVICE_ATTR_RO(default_profile);
+
+static ssize_t cooling_type_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 type;
+	int ret;
+
+	ret = awcc_thermal_information(priv->wdev, AWCC_OP_GET_COOLING_TYPE, 0,
+				       &type);
+	if (ret)
+		return ret;
+
+	switch (type) {
+	case AWCC_COOLING_AIR:
+		return sysfs_emit(buf, "air\n");
+	case AWCC_COOLING_LIQUID:
+		return sysfs_emit(buf, "liquid\n");
+	default:
+		return sysfs_emit(buf, "%u\n", type);
+	}
+}
+
+static DEVICE_ATTR_RO(cooling_type);
+
+static umode_t awcc_attr_is_visible(struct kobject *kobj,
+				    struct attribute *attr, int n)
+{
+	struct awcc_priv *priv;
+
+	/* Without AWCC support the drvdata is not an awcc_priv */
+	if (!awcc)
+		return 0;
+
+	priv = dev_get_drvdata(kobj_to_dev(kobj));
+
+	if (attr == &dev_attr_gmode.attr)
+		return priv->gmode ? attr->mode : 0;
+	if (attr == &dev_attr_default_profile.attr)
+		return priv->default_profile ? attr->mode : 0;
+	if (attr == &dev_attr_cooling_type.attr)
+		return priv->cooling_type ? attr->mode : 0;
+
+	return 0;
+}
+
+static struct attribute *awcc_attrs[] = {
+	&dev_attr_gmode.attr,
+	&dev_attr_default_profile.attr,
+	&dev_attr_cooling_type.attr,
+	NULL
+};
+
+static const struct attribute_group awcc_attribute_group = {
+	.attrs = awcc_attrs,
+	.is_visible = awcc_attr_is_visible,
+};
+
+/*
+ * Power information
+ *  - Read-only AC adapter information
+ */
+static ssize_t adapter_count_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 count;
+	int ret;
+
+	ret = awcc_power_information(priv->wdev, AWCC_OP_GET_ADAPTER_COUNT, 0,
+				     &count);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%u\n", count);
+}
+
+static DEVICE_ATTR_RO(adapter_count);
+
+static ssize_t adapter_watts_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 count, watts;
+	int len = 0;
+	int ret;
+
+	ret = awcc_power_information(priv->wdev, AWCC_OP_GET_ADAPTER_COUNT, 0,
+				     &count);
+	if (ret)
+		return ret;
+
+	count = min(count, AWCC_MAX_ADAPTERS);
+
+	for (unsigned int i = 0; i < count; i++) {
+		ret = awcc_power_information(priv->wdev,
+					     AWCC_OP_GET_ADAPTER_WATTS, i,
+					     &watts);
+		if (ret)
+			return ret;
+
+		len += sysfs_emit_at(buf, len, "%s%u", i ? " " : "", watts);
+	}
+
+	len += sysfs_emit_at(buf, len, "\n");
+
+	return len;
+}
+
+static DEVICE_ATTR_RO(adapter_watts);
+
+static ssize_t adapter_status_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 status;
+	int ret;
+
+	ret = awcc_power_information(priv->wdev, AWCC_OP_GET_ADAPTER_STATUS, 0,
+				     &status);
+	if (ret)
+		return ret;
+
+	switch (status) {
+	case AWCC_ADAPTER_STATUS_OK:
+		return sysfs_emit(buf, "ok\n");
+	case AWCC_ADAPTER_STATUS_UNDERSIZED:
+		return sysfs_emit(buf, "undersized\n");
+	case AWCC_ADAPTER_STATUS_UNSUPPORTED:
+		return sysfs_emit(buf, "unsupported\n");
+	default:
+		return sysfs_emit(buf, "%u\n", status);
+	}
+}
+
+static DEVICE_ATTR_RO(adapter_status);
+
+static bool power_info_group_visible(struct kobject *kobj)
+{
+	struct awcc_priv *priv;
+
+	if (!awcc)
+		return false;
+
+	priv = dev_get_drvdata(kobj_to_dev(kobj));
+
+	return priv->power_info;
+}
+DEFINE_SIMPLE_SYSFS_GROUP_VISIBLE(power_info);
+
+static struct attribute *power_info_attrs[] = {
+	&dev_attr_adapter_count.attr,
+	&dev_attr_adapter_watts.attr,
+	&dev_attr_adapter_status.attr,
+	NULL
+};
+
+static const struct attribute_group power_info_attribute_group = {
+	.name = "power_info",
+	.is_visible = SYSFS_GROUP_VISIBLE(power_info),
+	.attrs = power_info_attrs,
+};
+
+static const struct attribute_group *wmax_wmi_groups[] = {
+	&awcc_attribute_group,
+	&power_info_attribute_group,
+	NULL
+};
+
+/*
+ * Everything here is optional: a failure only hides the attribute.
+ */
+static void awcc_info_init(struct wmi_device *wdev)
+{
+	struct awcc_priv *priv = dev_get_drvdata(&wdev->dev);
+	bool listed;
+	u32 out;
+	int ret;
+
+	ret = awcc_gmode_listed(priv, &listed);
+	if (ret)
+		dev_dbg(&wdev->dev, "Failed to look for the G-Mode profile: %d\n", ret);
+
+	priv->gmode = !ret && listed && !priv->game_shift;
+
+	priv->default_profile = !awcc_thermal_information(wdev,
+							  AWCC_OP_GET_DEFAULT_PROFILE,
+							  0, &out);
+	priv->cooling_type = !awcc_thermal_information(wdev,
+						       AWCC_OP_GET_COOLING_TYPE,
+						       0, &out);
+	priv->power_info = !awcc_power_information(wdev,
+						   AWCC_OP_GET_ADAPTER_COUNT,
+						   0, &out);
+}
+
 /*
  * DebugFS
  */
@@ -1547,6 +1973,12 @@ static int alienware_awcc_setup(struct wmi_device *wdev)
 	priv->wdev = wdev;
 	dev_set_drvdata(&wdev->dev, priv);
 
+	ret = devm_mutex_init(&wdev->dev, &priv->gmode_lock);
+	if (ret)
+		return ret;
+
+	awcc_game_shift_init(priv);
+
 	if (awcc->hwmon) {
 		ret = awcc_hwmon_init(wdev);
 		if (ret)
@@ -1559,6 +1991,7 @@ static int alienware_awcc_setup(struct wmi_device *wdev)
 			return ret;
 	}
 
+	awcc_info_init(wdev);
 	awcc_debugfs_init(wdev);
 
 	return 0;
@@ -1640,6 +2073,7 @@ static struct wmi_driver alienware_wmax_wmi_driver = {
 		.name = "alienware-wmi-wmax",
 		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
 		.pm = pm_sleep_ptr(&wmax_wmi_pm_ops),
+		.dev_groups = wmax_wmi_groups,
 	},
 	.id_table = alienware_wmax_device_id_table,
 	.probe = wmax_wmi_probe,
