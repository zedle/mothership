 /*
+ * G-Mode
+ *  - On models that list the G-Mode thermal profile (0xAB) but have no
+ *    GameShiftStatus method, G-Mode is activated like any other thermal
+ *    profile. It is exposed as a switch of its own, so "performance" keeps
+ *    its regular profile and the previous profile can be restored.
+ */
+static int awcc_gmode_listed(struct awcc_priv *priv, bool *listed)
+{
+	u8 id, offset;
+	int ret;
+
+	offset = awcc_profile_id_offset(priv);
+	*listed = false;
+
+	for (unsigned int i = 0; i < priv->profile_count; i++) {
+		ret = awcc_op_get_resource_id(priv->wdev, i + offset, &id);
+		if (ret == -EBADRQC)
+			break;
+		if (ret)
+			return ret;
+
+		if (id == AWCC_PROFILE_SPECIAL_GMODE) {
+			*listed = true;
+			break;
+		}
+	}
+
+	return 0;
+}
+
+static void awcc_game_shift_init(struct awcc_priv *priv)
+{
+	u32 status;
+	int ret;
+
+	if (!awcc->gmode)
+		return;
+
+	/*
+	 * Some BIOSes that support G-Mode lack the GameShiftStatus method.
+	 * Calling it before every profile change would then make every
+	 * change fail.
+	 */
+	ret = awcc_game_shift_status(priv->wdev, AWCC_OP_GET_GAME_SHIFT_STATUS,
+				     &status);
+	if (ret) {
+		dev_warn(&priv->wdev->dev,
+			 "GameShiftStatus is not supported (%d), G-Mode will not be tied to the performance profile\n",
+			 ret);
+		return;
+	}
+
+	priv->game_shift = true;
+}
+
+static ssize_t gmode_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 profile;
+	int ret;
+
+	ret = awcc_op_get_current_profile(priv->wdev, &profile);
+	if (ret)
+		return ret;
+
+	profile = FIELD_GET(AWCC_RESOURCE_ID_MASK, profile);
+
+	return sysfs_emit(buf, "%d\n", profile == AWCC_PROFILE_SPECIAL_GMODE);
+}
+
+static ssize_t gmode_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct awcc_priv *priv = dev_get_drvdata(dev);
+	u32 current_profile, default_profile;
+	bool enable;
+	u8 target;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	scoped_guard(mutex, &priv->gmode_lock) {
+		ret = awcc_op_get_current_profile(priv->wdev, &current_profile);
+		if (ret)
+			return ret;
+
+		current_profile = FIELD_GET(AWCC_RESOURCE_ID_MASK, current_profile);
+
+		if (enable == (current_profile == AWCC_PROFILE_SPECIAL_GMODE))
+			return count;
+
+		if (enable) {
+			target = AWCC_PROFILE_SPECIAL_GMODE;
+		} else if (priv->gmode_restore_valid) {
+			target = priv->gmode_restore;
+		} else {
+			ret = awcc_thermal_information(priv->wdev,
+						       AWCC_OP_GET_DEFAULT_PROFILE,
+						       0, &default_profile);
+			if (ret)
+				return ret;
+
+			target = FIELD_GET(AWCC_RESOURCE_ID_MASK, default_profile);
+			if (target == AWCC_PROFILE_SPECIAL_GMODE)
+				return -EIO;
+		}
+
+		ret = awcc_op_activate_profile(priv->wdev, target);
+		if (ret)
+			return ret;
+
+		priv->gmode_restore = current_profile;
+		priv->gmode_restore_valid = enable;
+	}
+
+	if (priv->ppdev)
+		platform_profile_notify(priv->ppdev);
+
+	sysfs_notify(&dev->kobj, NULL, "gmode");
+
+	return count;
+}
+
+static DEVICE_ATTR(gmode, 0664, gmode_show, gmode_store);
